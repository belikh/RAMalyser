[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 140

[engines]
smtbmc boolector

[script]
prove: read_verilog -formal -DFORMAL -I. spi_regs.v
cover: read_verilog -formal -DFORMAL -DF_COVER -I. spi_regs.v
prep -top spi_regs

[files]
../rtl/spi_regs.v
spi_regs_props.vh
